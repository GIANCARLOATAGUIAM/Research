# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings > API). Never commit .env.local.

# Public values: sent to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Secret: server only. Used for admin user management (Phase 7).
# Never prefix with NEXT_PUBLIC_ and never import it in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Server only. Set to "enabled" to open student self-registration (/register).
# Turn on only after migration 0010 is applied and Supabase Auth sign-ups are
# enabled; otherwise sign-ups would create accounts without a profile.
# STUDENT_REGISTRATION=enabled
